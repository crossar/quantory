generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  username   String      @unique
  password   String
  firstName  String
  lastName   String
  toBuyItems ToBuyItem[]
  Item       Item[]
}

model Item {
  id        Int       @id @default(autoincrement())
  name      String
  location  Location
  quantity  Int
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
}

model ToBuyItem {
  id       Int      @id @default(autoincrement())
  name     String
  quantity Int
  userId   Int
  user     User     @relation(fields: [userId], references: [id])
  location Location?
}



enum Location {
  FRIDGE
  FREEZER
  PANTRY
  STORAGE
  MEDICINE
}
